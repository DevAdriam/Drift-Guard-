# GEMINI_API_KEY: Optional Gemini API key (automatically injected by AI Studio).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted URL of the application.
APP_URL="MY_APP_URL"

# ENCRYPTION_KEY: 32+ character secret used for AES-256-GCM encryption of
# stored target database connection URIs and alert webhook URLs.
ENCRYPTION_KEY=""

# Cloud SQL runtime variables (injected automatically in AI Studio)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""
